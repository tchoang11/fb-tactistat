# Copy to `.env`; only fill providers you use. Never commit real keys.
#     cp .env.example .env

# Groq - free, no credit card. https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini - free, no credit card. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cerebras - free, no credit card. https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# OpenRouter - free models capped at 50 requests/day until you top up.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# GitHub Models - a GitHub PAT with the `models:read` scope.
# https://github.com/settings/tokens
GITHUB_MODELS_TOKEN=

# OpenAI - paid. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Ollama needs no key; override only for a non-default endpoint.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Alibaba Cloud Model Studio (Qwen) - free token grant. https://modelstudio.console.alibabacloud.com
DASHSCOPE_API_KEY=
