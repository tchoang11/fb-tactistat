# Copy to `.env` and fill in only the providers you actually want to use.
# TactiStat enables a provider when its key is present and reports a clear
# error naming the missing variable when it is not. No key is required to run
# the data-loading, indexing, or retrieval-only evaluation steps.
#
#     cp .env.example .env
#
# `.env` is gitignored. Never commit real keys.

# Groq - free, no credit card. https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini - free, no credit card. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cerebras - free, no credit card. https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# OpenRouter - free models capped at 50 requests/day until you top up.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# GitHub Models - a GitHub PAT with the `models:read` scope.
# https://github.com/settings/tokens
GITHUB_MODELS_TOKEN=

# OpenAI - paid. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Ollama needs no key. If you run it somewhere other than the default port,
# override the base URL here.
# OLLAMA_BASE_URL=http://localhost:11434/v1
