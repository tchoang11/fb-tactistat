# --- Data --------------------------------------------------------------------
# Raw StatsBomb JSON is large (~150MB) and fully reproducible via
# `scripts/01_download_statsbomb.py`, so it is not tracked.
data/raw/

# Vector indexes and embedding caches are rebuildable artifacts.
data/index/
data/cache/
*.faiss
*.npy

# Processed tables ARE tracked (small, and they make the repo runnable without
# re-downloading 150MB). See data/processed/README.md.

# --- Eval artifacts ----------------------------------------------------------
# Raw per-run logs are noisy; the aggregated results tables are tracked.
eval/results/raw/
*.jsonl.gz

